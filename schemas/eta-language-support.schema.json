{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ShadowNineX/vscode-eta/main/schemas/eta-language-support.schema.json",
  "title": "Eta Language Support Manifest",
  "description": "Authoritative, generated language data consumed by Eta IntelliSense without executing project code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "inputs",
    "templates",
    "templateNames",
    "symbols"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/template"
      }
    },
    "templateNames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/templateName"
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symbol"
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*(?:/)\\.\\.?(?:/|$))[^\\u0000]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "trimMode": {
      "enum": [
        false,
        "nl",
        "slurp"
      ]
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tags",
        "parse",
        "customTags",
        "customTagTypes",
        "varName",
        "useWith",
        "functionHeader",
        "outputFunctionName",
        "async",
        "autoEscape",
        "autoFilter",
        "autoTrim",
        "rmWhitespace"
      ],
      "properties": {
        "tags": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          ],
          "items": false
        },
        "parse": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exec",
            "interpolate",
            "raw"
          ],
          "properties": {
            "exec": {
              "type": "string",
              "maxLength": 256
            },
            "interpolate": {
              "type": "string",
              "maxLength": 256
            },
            "raw": {
              "type": "string",
              "maxLength": 256
            }
          }
        },
        "customTags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "customTagTypes": {
          "type": "object",
          "propertyNames": {
            "minLength": 1,
            "maxLength": 256
          },
          "additionalProperties": {
            "enum": [
              "javascript",
              "text"
            ]
          }
        },
        "varName": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
          "maxLength": 256
        },
        "useWith": {
          "type": "boolean"
        },
        "functionHeader": {
          "type": "string",
          "maxLength": 2097152
        },
        "outputFunctionName": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
          "maxLength": 256
        },
        "async": {
          "type": "boolean"
        },
        "autoEscape": {
          "type": "boolean"
        },
        "autoFilter": {
          "type": "boolean"
        },
        "autoTrim": {
          "oneOf": [
            {
              "$ref": "#/$defs/trimMode"
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/trimMode"
                },
                {
                  "$ref": "#/$defs/trimMode"
                }
              ],
              "items": false
            }
          ]
        },
        "rmWhitespace": {
          "type": "boolean"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "start",
        "length"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "dataDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataPath",
        "location"
      ],
      "properties": {
        "dataPath": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "location": {
          "$ref": "#/$defs/location"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "length",
        "severity",
        "source",
        "message"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2097152
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceStart",
        "sourceLength",
        "virtualStart",
        "virtualLength"
      ],
      "properties": {
        "sourceStart": {
          "type": "integer",
          "minimum": 0
        },
        "sourceLength": {
          "type": "integer",
          "minimum": 1
        },
        "virtualStart": {
          "type": "integer",
          "minimum": 0
        },
        "virtualLength": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "options",
        "dataType",
        "dataDefinitions",
        "resolution",
        "relationships",
        "diagnostics",
        "virtualDocument"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "dataType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2097152
        },
        "dataDefinitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataDefinition"
          }
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "views",
            "defaultExtension"
          ],
          "properties": {
            "views": {
              "oneOf": [
                {
                  "$ref": "#/$defs/relativePath"
                },
                {
                  "type": "null"
                }
              ]
            },
            "defaultExtension": {
              "type": "string",
              "pattern": "^\\.",
              "maxLength": 64
            }
          }
        },
        "relationships": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "virtualDocument": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content",
            "mappings"
          ],
          "properties": {
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2097152
            },
            "mappings": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/mapping"
              }
            }
          }
        }
      }
    },
    "templateName": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "template"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "template": {
          "$ref": "#/$defs/relativePath"
        },
        "definition": {
          "$ref": "#/$defs/location"
        }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "start",
        "length",
        "role"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "definition",
            "reference"
          ]
        }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "occurrences"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "occurrences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/occurrence"
          }
        }
      }
    }
  }
}
