{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Eta",
  "scopeName": "source.eta",
  "patterns": [
    {
      "include": "#tags"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "tags": {
      "patterns": [
        {
          "name": "meta.tag.custom.eta",
          "begin": "(<%[-_]?\\s*)([#*@])",
          "end": "([-_]?)(%>)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.embedded.begin.eta"
            },
            "2": {
              "name": "keyword.operator.custom.eta"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.operator.whitespace-trim.eta"
            },
            "2": {
              "name": "punctuation.section.embedded.end.eta"
            }
          }
        },
        {
          "name": "meta.embedded.block.javascript.eta",
          "contentName": "source.js",
          "begin": "(<%[-_]?\\s*)([~=]?)",
          "end": "([-_]?)(%>)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.embedded.begin.eta"
            },
            "2": {
              "name": "keyword.operator.eta"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.operator.whitespace-trim.eta"
            },
            "2": {
              "name": "punctuation.section.embedded.end.eta"
            }
          },
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        }
      ]
    }
  }
}
