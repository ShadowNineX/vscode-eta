{
  "name": "eta-language-support",
  "displayName": "Eta IntelliSense",
  "description": "Typed IntelliSense, syntax highlighting, autocomplete, and diagnostics for Eta templates",
  "icon": "assets/icon.png",
  "version": "0.3.0",
  "publisher": "ShadowNine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShadowNineX/vscode-eta.git"
  },
  "bugs": {
    "url": "https://github.com/ShadowNineX/vscode-eta/issues"
  },
  "homepage": "https://github.com/ShadowNineX/vscode-eta#readme",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "eta",
    "template",
    "templating",
    "language",
    "intellisense",
    "syntax"
  ],
  "main": "./out/extension.js",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "1.120.0",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "@vscode/test-electron": "^3.1.0",
    "eta": "^4.6.0",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vscode-jsonrpc": "^9.0.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "bun run typecheck && tsdown",
    "typecheck": "tsc -p ./ --noEmit",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "bun run compile && vitest run --coverage",
    "test:vscode": "bun run compile && bun scripts/runVscodeTests.ts",
    "pretest": "bun run compile"
  },
  "contributes": {
    "languages": [
      {
        "id": "eta",
        "aliases": [
          "Eta",
          "eta"
        ],
        "extensions": [
          ".eta"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "eta",
        "scopeName": "source.eta",
        "path": "./syntaxes/eta.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.javascript.eta": "javascript"
        }
      },
      {
        "scopeName": "source.eta.injection",
        "path": "./syntaxes/eta-injection.tmLanguage.json",
        "injectTo": [
          "source.eta",
          "text.html.basic"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.javascript.eta": "javascript"
        }
      }
    ],
    "snippets": [
      {
        "language": "eta",
        "path": "./snippets/eta.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".eta-language-support.json",
        "url": "./schemas/eta-language-support.schema.json"
      }
    ],
    "configuration": {
      "title": "Eta",
      "properties": {
        "eta.tags.open": {
          "type": "string",
          "default": "<%",
          "description": "Eta opening delimiter."
        },
        "eta.tags.close": {
          "type": "string",
          "default": "%>",
          "description": "Eta closing delimiter."
        },
        "eta.parse.exec": {
          "type": "string",
          "default": "",
          "description": "Eta evaluation tag prefix."
        },
        "eta.parse.interpolate": {
          "type": "string",
          "default": "=",
          "description": "Eta escaped interpolation tag prefix."
        },
        "eta.parse.raw": {
          "type": "string",
          "default": "~",
          "description": "Eta raw interpolation tag prefix."
        },
        "eta.customTags": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Custom Eta tag prefixes. Eta runtime customTags are handler functions; list only their prefixes here for language support."
        },
        "eta.customTagTypes": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "javascript",
              "text"
            ]
          },
          "description": "Safe language metadata for custom tag prefixes. Mark a prefix as 'javascript' only when its handler receives JavaScript expression or statement content; handlers are never executed by the extension."
        },
        "eta.varName": {
          "type": "string",
          "default": "it",
          "description": "Name of the Eta template data variable."
        },
        "eta.useWith": {
          "type": "boolean",
          "default": false,
          "description": "Expose top-level properties from the inferred data object as template variables."
        },
        "eta.functionHeader": {
          "type": "string",
          "default": "",
          "description": "JavaScript/TypeScript declarations to inject before template code for language features."
        },
        "eta.outputFunctionName": {
          "type": "string",
          "default": "output",
          "description": "Name of the Eta output helper function."
        },
        "eta.async": {
          "type": "boolean",
          "default": false,
          "description": "Compile and model Eta templates as async functions."
        },
        "eta.autoEscape": {
          "type": "boolean",
          "default": true,
          "description": "Mirror Eta's automatic XML-escaping option for language modeling."
        },
        "eta.autoFilter": {
          "type": "boolean",
          "default": false,
          "description": "Mirror Eta's automatic interpolation filter option for language modeling."
        },
        "eta.autoTrim": {
          "default": [
            false,
            "nl"
          ],
          "anyOf": [
            {
              "type": "boolean",
              "enum": [
                false
              ]
            },
            {
              "type": "string",
              "enum": [
                "nl",
                "slurp"
              ]
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "anyOf": [
                  {
                    "type": "boolean",
                    "enum": [
                      false
                    ]
                  },
                  {
                    "type": "string",
                    "enum": [
                      "nl",
                      "slurp"
                    ]
                  }
                ]
              }
            }
          ],
          "description": "Mirror Eta's automatic whitespace trimming mode."
        },
        "eta.rmWhitespace": {
          "type": "boolean",
          "default": false,
          "description": "Mirror Eta's global whitespace removal option."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  }
}
